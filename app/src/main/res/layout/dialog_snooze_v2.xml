<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_white">

    <!-- TOP ROW: Title + Close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ WARNING"
            android:fontFamily="@font/league_spartan_"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brand_button_red"
            android:textAlignment="center"/>

        <ImageView
            android:id="@+id/btnCloseSnooze"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/brand_button_red"/>

    </LinearLayout>

    <!-- MAIN MESSAGE -->
    <TextView
        android:id="@+id/tvSnoozeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message set by SnoozeDialogFragment"
        android:fontFamily="sans-serif"
        android:textSize="14sp"
        android:textColor="@color/text_navy"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="8dp"/>

    <!-- SNOOZE COUNT -->
    <TextView
        android:id="@+id/tvSnoozeCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snoozes Left: 0"
        android:fontFamily="sans-serif"
        android:textSize="13sp"
        android:textStyle="italic"
        android:textColor="@color/hint_grey"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <!-- USE SNOOZE BUTTON -->
    <Button
        android:id="@+id/btnUseSnooze"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="USE SNOOZE"
        android:fontFamily="@font/league_spartan_"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/brand_deep_blue"/>

    <!-- LOG WITHOUT SNOOZE BUTTON -->
    <Button
        android:id="@+id/btnLogWithoutSnooze"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LOG WITHOUT SNOOZE"
        android:fontFamily="@font/league_spartan_"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/brand_button_red"/>

</LinearLayout>