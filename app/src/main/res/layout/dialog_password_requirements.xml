<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/dialogPReq">

    <ProgressBar
        android:id="@+id/pbPStrength"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="6dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar_gradient" />

    <TextView
        android:id="@+id/tvPRequirements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/league_spartan_"
        android:textColor="@color/text_white"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="Must include: a digit · an uppercase char ·a lowercase char ·a special char · 8+ chars" />

</LinearLayout>